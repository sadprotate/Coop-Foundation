; Godot 4.6 project. Open this file in the Godot editor.
config_version=5

[application]
config/name="Co-op Foundation"
config/version="0.7.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/description="A four-player medieval town and combat sandbox with ten-round free-for-all, Red vs Blue 2v2, and host gameplay options."

[display]
window/size/viewport_width=1280
window/size/viewport_height=800
window/size/window_width_override=1280
window/size/window_height_override=800
window/size/min_width=960
window/size/min_height=640
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.035, 0.051, 0.078, 1)

[autoload]
Prefs="*res://scripts/settings.gd"
Net="*res://scripts/network.gd"
Sound="*res://scripts/audio.gd"
